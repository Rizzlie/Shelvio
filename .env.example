# Copy to .env and fill in. Never commit .env.
# The API validates every variable at startup and refuses to start, naming each one that is
# missing or invalid. Nx loads this file for `nx serve api`.

# development | production | test
NODE_ENV=development

# Port the API listens on. The web dev server proxies /api to it (apps/web/proxy.conf.json).
PORT=3000

# Postgres connection URL (postgres:// or postgresql://). Matches the database in compose.yaml (host port 5434).
DATABASE_URL=postgres://shelvio:shelvio@127.0.0.1:5434/shelvio

# Origin of the web app, without a path. Locally the app is same-origin through the dev-server proxy.
APP_ORIGIN=http://localhost:4200

# Google OAuth web client (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed as an authorised redirect URI on the client above.
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback

# Comma-separated emails that may sign up without an Invitation (compared lowercased). May be empty.
SIGNUP_ALLOWLIST=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Discogs personal access token (discogs.com > Settings > Developers). Used from mvp-catalog on.
DISCOGS_TOKEN=
