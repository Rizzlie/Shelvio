{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@shelvio/api/config": ["./libs/api/config/src/index.ts"],
      "@shelvio/api/db": ["./libs/api/db/src/index.ts"],
      "@shelvio/api/db/testing": ["./libs/api/db/src/testing/index.ts"],
      "@shelvio/api/errors": ["./libs/api/errors/src/index.ts"],
      "@shelvio/api/testing/fake-oidc": ["./libs/api/testing/fake-oidc/src/index.ts"],
      "@shelvio/shared/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@shelvio/web/shared/i18n": ["./libs/web/shared/i18n/src/index.ts"],
      "@shelvio/web/not-found/feature": ["./libs/web/not-found/feature/src/index.ts"],
      "@shelvio/web/shared/theme": ["./libs/web/shared/theme/src/index.ts"],
      "@shelvio/web/shared/ui": ["./libs/web/shared/ui/src/index.ts"],
      "@shelvio/web/shared/formatting": ["./libs/web/shared/formatting/src/index.ts"],
      "@shelvio/web/shared/formatting/isbn": ["./libs/web/shared/formatting/src/isbn/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
